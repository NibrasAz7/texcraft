{
  "tools": [
    {
      "name": "BibTeX (.warraqcraft)",
      "argv": ["bibtex", ".warraqcraft/{stem}"],
      "capture": true
    },
    {
      "name": "MakeIndex (.warraqcraft)",
      "argv": ["makeindex", ".warraqcraft/{stem}.idx"],
      "capture": true
    },
    {
      "name": "word count (detex)",
      "argv": ["perl", "-e", "local $/; $_=<>; s/\\\\[a-zA-Z@]+(\\[[^\\]]*\\])?(\\{[^{}]*\\})?/ /g; s/[{}$%&~^_]/ /g; @w=split; print scalar(@w), \" words\\n\";", "{file}"],
      "capture": true
    }
  ]
}
